def give_change(amount):
    coins = [50, 10, 5, 2, 1]
    change_result = {}
    
    for coin in coins:
        if amount >= coin:
            count = amount // coin  # Сколько монет данного номинала помещается
            amount %= coin         # Оставшаяся сумма
            change_result[coin] = count
            
    return change_result

