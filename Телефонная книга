# Создаем словарь на 5 контактов
phone_book = {
    "Рома": "+7 (999) 111-22-33",
    "Вадим": "+7 (999) 444-55-66",
    "Эльдар": "+7 (999) 777-88-99",
    "Миша": "+7 (999) 222-33-44",
    "Аня": "+7 (999) 555-66-77"
}

# Поиск контакта
name = input("Введите имя для поиска: ")

if name in phone_book:
    print(f"Номер телефона {name}: {phone_book[name]}")
else:
    print("Контакт не найден")
