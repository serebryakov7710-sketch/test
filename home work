def selection_sort_desc(arr):
    n = len(arr)
    for i in range(n):
        max_idx = i
        for j in range(i + 1, n):
            if arr[j] > arr[max_idx]:  # Изменен знак
                max_idx = j
        arr[i], arr[max_idx] = arr[max_idx], arr[i]
    return arr

grades = [4, 2, 5, 3, 5, 4, 3]
print("По убыванию:", selection_sort_desc(grades))
# Вывод: [5, 5, 4, 4, 3, 3,
