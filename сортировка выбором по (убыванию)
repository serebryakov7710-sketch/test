def selection_sort_descending(arr):
    n = len(arr)
    for i in range(n):
        # Находим максимальный элемент в оставшейся части списка
        max_idx = i
        for j in range(i + 1, n):
            if arr[j] > arr[max_idx]:
                max_idx = j
            
        # Меняем местами текущий элемент и найденный максимальный
        arr[i], arr[max_idx] = arr[max_idx], arr[i]
    return arr

# Проверка
scores = [4, 2, 5, 3, 5, 4, 3]
print("Python (по убыванию):", selection_sort_descending(scores))
